# MAIN SIMULATION PIPELINE
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------

# Main simulation controller (internal lock model).
# The script now uses separate internal locks:
#   - sim_enqueue.lock    (fast STEP_0 enqueue phase)
#   - sim_processing.lock (run_step + housekeeping)
#   - sim_final.lock      (STEP_FINAL owner lock)
# Do not wrap this cron entry in an external flock; that would re-introduce
# enqueue starvation whenever processing is long.
#
# STEP_FINAL ownership policy:
#   - run_main performs STEP_FINAL before pruning completed mesh rows; the
#     standalone STEP_FINAL cron retries any remaining eligible inputs.
#   - both paths use the same lock, so STEP_FINAL cannot run concurrently.
# Optional alert wiring (for run_step persistent stuck/broken alerts):
#   - set SIM_ALERT_TELEGRAM_CHAT_IDS="id1,id2" inline below, or
#   - populate CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/NOTIFICATIONS/TELEGRAM_BOT/ALERT_CHAT_IDS.txt
* * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/SIMULATION/RUN/sim_main_pipeline_cycle.log -- SIM_PROCESSING_RUN_STEP_FINAL=1 /bin/bash $DATAFLOW_ROOT/PIPELINE/MINGO_DIGITAL_TWIN/ORCHESTRATOR/core/run_main_simulation_cycle.sh
* * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/SIMULATION/STEP_FINAL/step_final_cron.log -- /bin/bash $DATAFLOW_ROOT/PIPELINE/MINGO_DIGITAL_TWIN/ORCHESTRATOR/core/run_step_final_cron.sh

# Ensure simulation hashes (daily, serialized with processing phase).
# DISABLED: 25 6 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/ensure_sim_hashes.log -- /usr/bin/flock -n $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/LOCKS/cron/sim_processing.lock $PYTHON_BIN $DATAFLOW_ROOT/PIPELINE/MINGO_DIGITAL_TWIN/ORCHESTRATOR/maintenance/sim_maintenance.py ensure-hashes --apply --run-validate-quick


