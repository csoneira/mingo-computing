# Render ONLY through CONTEXTUAL/CONFIG/SETUP/setup.sh; do not install this template with crontab.
# MINGO ANALYSIS PC CRONTAB

# Edit this file to introduce tasks to be run by cron.
# minute hour day_of_month month day_of_week command
# Cron files sometimes require ending with a newline, and this case is.

# Updated at 2026-06-11

SHELL=/bin/bash
PATH=@REPO_ROOT@/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
PYTHON_BIN=@REPO_ROOT@/.venv/bin/python3
MPLBACKEND=Agg
RSYNC_RSH="ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10"
DATAFLOW_ROOT=@REPO_ROOT@
MASTER_STAGE_ROOT=@REPO_ROOT@/PIPELINE/MINGO_ANALYSIS/MINGO_ANALYSIS_SCRIPTS/STAGES

# Only persistent runtime state is bootstrapped. Log directories are created lazily by
# cron_run_logged.sh when a command actually emits output or fails.
@reboot /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/SETUP/initialize_runtime_directories.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/CONFIG/SETUP/run-job.sh -- /bin/mkdir -p $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/LOCKS/cron $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/STATE/REPROCESS_BASENAMES $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/REMOTE_LOG_BACKUP/cron
@reboot /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/SETUP/start_dataflow_tmux.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/CONFIG/SETUP/run-job.sh -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/CONFIG/SETUP/start-dataflow-tmux --detach
# Recreate the monitor if it was stopped or its tmux server exited.
*/5 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/SETUP/start_dataflow_tmux.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/CONFIG/SETUP/run-job.sh -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/CONFIG/SETUP/start-dataflow-tmux --detach



# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# ANCILLARY
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------
# --------------------------------------------------------------------------------

# Telegram bot watchdog (runs persistent_telegram_bot_check.sh)
* * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/TELEGRAM_BOT/cron_persistent_telegram_bot.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/NOTIFICATIONS/TELEGRAM_BOT/persistent_telegram_bot_check.sh

# Save copy the core files
0 5 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/BACKUP/rsync_safe_dataflow_v3.log -- rsync -av --exclude-from="$DATAFLOW_ROOT/CONTEXTUAL/CONFIG/safe_dataflow_rsync_excludes.list" $DATAFLOW_ROOT/ $HOME/.safe-mingo-computing/

# Backup remote station log trees (internal lock model in run_log_backup.sh)
0 */12 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/REMOTE_LOG_BACKUP/log_backup.cron.log -- /usr/bin/env bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/REMOTE_LOG_BACKUP/run_log_backup.sh


# Save snapshot of the config file
0 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/VERSION_CONTROL/log_snapshot_config.log -- $PYTHON_BIN -u $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/OBSERVABILITY/VERSION_CONTROL/snapshot_config.py

# DISABLED: automatically copy generated plots into documentation every 30 minutes.
# */30 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/UPDATE_PLOTS/update_plots.log -- /bin/bash $DATAFLOW_ROOT/DOCUMENTATION/docs/assets/update_plots.sh

# Collect Tracebacks from cron logs
*/10 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/SEARCH_FOR_ERRORS/error_finder.log -- $PYTHON_BIN $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/OBSERVABILITY/SEARCH_FOR_ERRORS/error_finder.py

# Hourly category-based cleanup. Edit CLEANERS/cleaner_config.json to select files.
# --force bypasses only disk threshold; age, retention and category protections remain.
# 0 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/MAINTENANCE/CLEANERS/clean_dataflow.sh --force >> $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/CLEANERS/log_clean_dataflow.log 2>&1
# 0 */2 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/MAINTENANCE/CLEANERS/clean_dataflow.sh --select temps,plots,completed --force --keep-final >> $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/CLEANERS/log_temps_clean_dataflow.log 2>&1
0 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/CLEANERS/log_temps_clean_dataflow.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/MAINTENANCE/CLEANERS/clean_dataflow.sh --apply --force --compact

# Solve stale locks (force 15 min age and kill matching stale pipelines)
*/5 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/SOLVE_STALE_LOCKS/solve_stale_locks.cron.log -- $PYTHON_BIN $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/SOLVE_STALE_LOCKS/solve_stale_locks.py --force-age-minutes 15 --kill-stale-processes

# Watchdog: prevent process explosions by capping per-job counts
*/5 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/WATCHDOG_PROCESS_COUNTS/watchdog_process_counts.cron.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/WATCHDOG_PROCESS_COUNTS/watchdog_process_counts.sh

# Emergency saturation guard: if too many duplicate/pending DATAFLOW jobs pile up, stop them
*/2 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/CLEANERS/stop_execution.log -- PROC_THRESHOLD=25 DUP_THRESHOLD=5 LOAD_FACTOR=2.0 GRACE_SECONDS=6 /bin/bash $DATAFLOW_ROOT/PIPELINE/MINGO_DIGITAL_TWIN/ORCHESTRATOR/maintenance/stop_execution.sh

# Truncate cron logs nightly at 23:00 and remove empty log directories.
0 23 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/ERASE_ALL_CRON_LOGS/erase_cron_logs.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/MAINTENANCE/ERASE_ALL_CRON_LOGS/erase_cron_logs.sh

# NMDB update
# 0 2 * * * /bin/bash $MASTER_STAGE_ROOT/STAGE_3/nmdb_retrieval.sh >> $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/log_nmdb_retrieval.log 2>&1

# Swap autoclear if idle, so the pipeline does not stop because of full swap event though the PC is idle
*/2 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/AUTO_CLEAR_SWAP/auto_clear_swap_if_idle.log -- $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/MAINTENANCE/AUTO_CLEAR_SWAP/auto_clear_swap_if_idle.sh

# Update station_automation_scripts, the directory with the software I made for the stations
0 1 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/REMOTE_SYNC/STATION_AUTOMATION_SCRIPTS/update_mingo01.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/REMOTE_SYNC/sync_station_scripts.sh 1
0 2 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/REMOTE_SYNC/STATION_AUTOMATION_SCRIPTS/update_mingo02.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/REMOTE_SYNC/sync_station_scripts.sh 2
# DISABLED 2026-11-12: MINGO03 is retired/unreachable. 0 3 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/REMOTE_SYNC/STATION_AUTOMATION_SCRIPTS/update_mingo03.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/REMOTE_SYNC/sync_station_scripts.sh 3
0 4 * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/REMOTE_SYNC/STATION_AUTOMATION_SCRIPTS/update_mingo04.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/REMOTE_SYNC/sync_station_scripts.sh 4

# Audit and reconcile Stage 0 through the Parquet Lake. This is now the sole
# producer of MINGOxx_processed_basenames.csv: only valid lake Parquets count.
# Repairs remain restricted to config_selection.yaml ranges and are deferred
# while /home is at or above the script storage safety threshold.
2-47/15 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/FILE_FLOW_TRACKER/file_flow_tracker.log -- $PYTHON_BIN $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/FILE_FLOW_TRACKER/file_flow_tracker.py --apply

# Lightweight read-only status refresh for real-time dashboards. It reuses the
# last deep metadata snapshot and scans only live artifacts and lake files.
* * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/FILE_FLOW_TRACKER/file_flow_realtime.log -- $PYTHON_BIN $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/FILE_FLOW_TRACKER/file_flow_realtime.py

# Repair malformed STEP_1 event metadata files before downstream readers hit parser errors
*/15 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/FIX_METADATA_FILES/fix_event_metadata_files.log -- /usr/bin/flock -n $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/LOCKS/cron/fix_event_metadata_files.lock $PYTHON_BIN $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/FIX_METADATA_FILES/fix_event_metadata_files.py --quiet-if-clean

# Remove the UNPROCESSED files if already in the list of processed
5 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/FLUSH_FROM_UNPROCESSED/flush_from_unprocessed.log -- /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/DATA_MAINTENANCE/FLUSH_FROM_UNPROCESSED/flush_from_unprocessed.sh

# Run metadata QA hourly without generating plots; keep table and manifest updates.
10 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/QUALITY_ASSURANCE/quality_assurance_often.cron.log -- /bin/bash $DATAFLOW_ROOT/PIPELINE/MINGO_ANALYSIS/MINGO_ANALYSIS_SCRIPTS/QUALITY_ASSURANCE/run_quality_assurance_cron.sh often

# Update column monitoring in the pipeline
0 * * * * /bin/bash $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/ORCHESTRATION/CRON_RUN_LOGGED/cron_run_logged.sh $DATAFLOW_ROOT/CONTEXTUAL/OPERATIONS/OPERATIONS_RUNTIME/CRON_LOGS/ANCILLARY/OPERATIONS/FOLLOW_COLUMNS/generate_columns_review.log -- $PYTHON_BIN @REPO_ROOT@/CONTEXTUAL/OPERATIONS/OPERATIONS_SCRIPTS/OBSERVABILITY/FOLLOW_COLUMNS/generate_columns_review.py


